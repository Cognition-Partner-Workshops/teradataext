# =========================================================================================
# teradataext - credentials file example
#
# Preferred: export TD_USER and TD_PASS in the environment instead of using a file.
#
# To use a file: copy this example OUTSIDE the repository, e.g.
#     cp config/credentials.ini.example ~/.teradataext/credentials.ini
#     chmod 600 ~/.teradataext/credentials.ini
# and set [teradata] credentials_file in main_config.ini to that path. The file must be
# owned by the user running the utility and have no group/other permissions (0600 or
# 0400), otherwise the utility exits with code 2. Never commit a real credentials file.
# Comments must be on their own line: inline comments are not supported.
# =========================================================================================

[credentials]
user = etl_user
password = change_me
