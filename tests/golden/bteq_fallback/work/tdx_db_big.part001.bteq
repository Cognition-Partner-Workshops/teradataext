.SET SESSION CHARSET 'ASCII';
.LOGON tdfake.example.com/tdx_test_user,********
.SET ERROROUT STDOUT;
.SET ERRORLEVEL UNKNOWN SEVERITY 8;
.EXPORT DATA FILE = <ROOT>/data/tdx_db_big.part001.dat.raw;
/* TDX query=export db=TDX_DB table=BIG chunk=1/4 */ SELECT CAST(CAST(TRANSLATE(CASE WHEN "ID" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("ID" AS FORMAT '-(10)9') AS VARCHAR(25))) END USING UNICODE_TO_LATIN) AS VARCHAR(20)) || TRANSLATE('|' USING UNICODE_TO_LATIN) || CAST(TRANSLATE(CASE WHEN "VAL" IS NULL THEN '\N' WHEN CHARACTER_LENGTH(OREPLACE("VAL", '00'XC, '')) = 0 THEN '\E' ELSE TRANSLATE(OREPLACE(OREPLACE(OREPLACE(OREPLACE(OREPLACE("VAL", '00'XC, ''), '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) USING UNICODE_TO_LATIN) END USING UNICODE_TO_LATIN) AS VARCHAR(40)) AS VARCHAR(64000)) AS tdx_rec FROM "TDX_DB"."BIG" WHERE ("ID" < 8 OR "ID" IS NULL);
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.LOGOFF;
.QUIT 0;
