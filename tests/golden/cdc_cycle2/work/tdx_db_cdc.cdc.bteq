.SET SESSION CHARSET 'ASCII';
.LOGON tdfake.example.com/tdx_test_user,********
.SET ERROROUT STDOUT;
.SET ERRORLEVEL UNKNOWN SEVERITY 8;
.EXPORT DATA FILE = <ROOT>/work/tdx_db_cdc.cdc.q1.raw;
/* TDX query=cdcmax db=TDX_DB table=CDC cdc_gt="2024-03-01 00:00:00.000000" */ SELECT COALESCE(CAST(OREPLACE(OREPLACE(TRIM(CAST(CAST(CAST(CAST(MAX("UPDATED_TS") AS TIMESTAMP(6)) AS FORMAT 'YYYY-MM-DDBHH:MI:SS.S(6)') AS CHAR(26)) AS VARCHAR(256))), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') FROM "TDX_DB"."CDC" WHERE ("UPDATED_TS" > TIMESTAMP '2024-03-01 00:00:00.000000');
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.LOGOFF;
.QUIT 0;
