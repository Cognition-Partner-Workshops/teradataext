.SET SESSION CHARSET 'ASCII';
.LOGON tdfake.example.com/tdx_test_user,********
.SET ERROROUT STDOUT;
.SET ERRORLEVEL UNKNOWN SEVERITY 8;
.EXPORT DATA FILE = <ROOT>/work/tdx_db_cdc.count.q1.raw;
/* TDX query=count db=TDX_DB table=CDC cdc_gt="2024-03-01 00:00:00.000000" cdc_le="2024-04-15 00:00:00.000000" */ SELECT COALESCE(OREPLACE(OREPLACE(TRIM(CAST(CAST(COUNT(*) AS BIGINT) AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') FROM "TDX_DB"."CDC" WHERE ("UPDATED_TS" > TIMESTAMP '2024-03-01 00:00:00.000000' AND "UPDATED_TS" <= TIMESTAMP '2024-04-15 00:00:00.000000');
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.LOGOFF;
.QUIT 0;
