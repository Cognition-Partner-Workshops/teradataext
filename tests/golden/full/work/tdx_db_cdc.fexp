.LOGTABLE tdx_lt_<H>;
.LOGON tdfake.example.com/tdx_test_user,********
.BEGIN EXPORT SESSIONS 4 TENACITY 0;
.EXPORT OUTFILE <ROOT>/data/tdx_db_cdc.dat.raw FORMAT TEXT MODE RECORD;
/* TDX query=export db=TDX_DB table=CDC cdc_le="2024-03-01 00:00:00.000000" */ SELECT CAST(CAST(CASE WHEN "ID" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("ID" AS FORMAT '-(10)9') AS VARCHAR(25))) END AS VARCHAR(20)) || '|' || CAST(CASE WHEN "VAL" IS NULL THEN '\N' WHEN CHARACTER_LENGTH("VAL") = 0 THEN '\E' ELSE TRANSLATE(OREPLACE(OREPLACE(OREPLACE(OREPLACE("VAL", '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) USING UNICODE_TO_LATIN) END AS VARCHAR(40)) || '|' || CAST(CASE WHEN "UPDATED_TS" IS NULL THEN '\N' ELSE SUBSTR(TRIM(CAST(CAST("UPDATED_TS" AS FORMAT 'YYYY-MM-DDBHH:MI:SS.S(6)') AS VARCHAR(27))), 1, 10) || 'T' || SUBSTR(TRIM(CAST(CAST("UPDATED_TS" AS FORMAT 'YYYY-MM-DDBHH:MI:SS.S(6)') AS VARCHAR(27))), 12) END AS VARCHAR(28)) AS VARCHAR(64000)) AS tdx_rec FROM "TDX_DB"."CDC" WHERE ("UPDATED_TS" <= TIMESTAMP '2024-03-01 00:00:00.000000' OR "UPDATED_TS" IS NULL);
.END EXPORT;
.LOGOFF;
