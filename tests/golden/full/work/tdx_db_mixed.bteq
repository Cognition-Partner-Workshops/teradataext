.SET SESSION CHARSET 'ASCII';
.LOGON tdfake.example.com/tdx_test_user,********
.SET ERROROUT STDOUT;
.SET ERRORLEVEL UNKNOWN SEVERITY 8;
.EXPORT DATA FILE = <ROOT>/data/tdx_db_mixed.dat.raw;
/* TDX query=export db=TDX_DB table=MIXED */ SELECT CAST(CAST(CASE WHEN "ID" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("ID" AS FORMAT '-(10)9') AS VARCHAR(25))) END AS VARCHAR(20) CHARACTER SET LATIN) || TRANSLATE('|' USING UNICODE_TO_LATIN) || CAST(CASE WHEN "AMT" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("AMT" AS FORMAT '-(8)9.9(2)') AS VARCHAR(13))) END AS VARCHAR(13) CHARACTER SET LATIN) || TRANSLATE('|' USING UNICODE_TO_LATIN) || CAST(CASE WHEN "BIG_AMT" IS NULL THEN '\N' ELSE '"' || TRIM(CAST(CAST("BIG_AMT" AS FORMAT '-(34)9.9(4)') AS VARCHAR(41))) || '"' END AS VARCHAR(43) CHARACTER SET LATIN) || TRANSLATE('|' USING UNICODE_TO_LATIN) || CAST(CASE WHEN "NAME" IS NULL THEN '\N' WHEN CHARACTER_LENGTH("NAME") = 0 THEN '\E' ELSE TRANSLATE(OREPLACE(OREPLACE(OREPLACE(OREPLACE(OREPLACE("NAME", '00'XC, ''), '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) USING UNICODE_TO_LATIN) END AS VARCHAR(100) CHARACTER SET LATIN) || TRANSLATE('|' USING UNICODE_TO_LATIN) || CAST(CASE WHEN "BIZ_DATE" IS NULL THEN '\N' ELSE CAST(CAST("BIZ_DATE" AS FORMAT 'YYYY-MM-DD') AS CHAR(10)) END AS VARCHAR(10) CHARACTER SET LATIN) || TRANSLATE('|' USING UNICODE_TO_LATIN) || CAST(CASE WHEN "CREATED_TS" IS NULL THEN '\N' ELSE SUBSTR(TRIM(CAST(CAST("CREATED_TS" AS FORMAT 'YYYY-MM-DDBHH:MI:SS.S(6)') AS VARCHAR(27))), 1, 10) || 'T' || SUBSTR(TRIM(CAST(CAST("CREATED_TS" AS FORMAT 'YYYY-MM-DDBHH:MI:SS.S(6)') AS VARCHAR(27))), 12) END AS VARCHAR(28) CHARACTER SET LATIN) || TRANSLATE('|' USING UNICODE_TO_LATIN) || CAST(CASE WHEN "EVENT_TSZ" IS NULL THEN '\N' ELSE SUBSTR(TRIM(CAST(CAST(CAST(("EVENT_TSZ" AT TIME ZONE INTERVAL '00:00' HOUR TO MINUTE) AS TIMESTAMP(6)) AS FORMAT 'YYYY-MM-DDBHH:MI:SS.S(6)') AS VARCHAR(27))), 1, 10) || 'T' || SUBSTR(TRIM(CAST(CAST(CAST(("EVENT_TSZ" AT TIME ZONE INTERVAL '00:00' HOUR TO MINUTE) AS TIMESTAMP(6)) AS FORMAT 'YYYY-MM-DDBHH:MI:SS.S(6)') AS VARCHAR(27))), 12) || 'Z' END AS VARCHAR(28) CHARACTER SET LATIN) || TRANSLATE('|' USING UNICODE_TO_LATIN) || CAST(CASE WHEN "PAYLOAD" IS NULL THEN '\N' WHEN BYTES("PAYLOAD") = 0 THEN '\E' ELSE FROM_BYTES("PAYLOAD", 'base16') END AS VARCHAR(32) CHARACTER SET LATIN) AS VARCHAR(64000) CHARACTER SET LATIN) AS tdx_rec FROM "TDX_DB"."MIXED";
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.LOGOFF;
.QUIT 0;
