.SET SESSION CHARSET 'ASCII';
.LOGON tdfake.example.com/tdx_test_user,********
.SET ERROROUT STDOUT;
.SET ERRORLEVEL UNKNOWN SEVERITY 8;
.EXPORT DATA FILE = <ROOT>/work/tdx_db_big.meta.q1.raw;
/* TDX query=columns db=TDX_DB table=BIG */ SELECT COALESCE(OREPLACE(OREPLACE(TRIM(CAST(ColumnId AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') || '|' || COALESCE(OREPLACE(OREPLACE(CAST(ColumnName AS VARCHAR(256))), '\', '\\'), '|', '\|'), '\N') || '|' || COALESCE(OREPLACE(OREPLACE(TRIM(CAST(ColumnType AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') || '|' || COALESCE(OREPLACE(OREPLACE(TRIM(CAST(ColumnLength AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') || '|' || COALESCE(OREPLACE(OREPLACE(TRIM(CAST(DecimalTotalDigits AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') || '|' || COALESCE(OREPLACE(OREPLACE(TRIM(CAST(DecimalFractionalDigits AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') || '|' || COALESCE(OREPLACE(OREPLACE(TRIM(CAST(Nullable AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') || '|' || COALESCE(OREPLACE(OREPLACE(TRIM(CAST(CharType AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') FROM DBC.ColumnsV WHERE DatabaseName = 'TDX_DB' AND TableName = 'BIG' ORDER BY ColumnId;
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.EXPORT DATA FILE = <ROOT>/work/tdx_db_big.meta.q2.raw;
/* TDX query=index db=TDX_DB table=BIG */ SELECT COALESCE(OREPLACE(OREPLACE(TRIM(CAST(IndexType AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') || '|' || COALESCE(OREPLACE(OREPLACE(TRIM(CAST(UniqueFlag AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') || '|' || COALESCE(OREPLACE(OREPLACE(TRIM(CAST(ColumnPosition AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') || '|' || COALESCE(OREPLACE(OREPLACE(CAST(ColumnName AS VARCHAR(256))), '\', '\\'), '|', '\|'), '\N') FROM DBC.IndicesV WHERE DatabaseName = 'TDX_DB' AND TableName = 'BIG' ORDER BY IndexNumber, ColumnPosition;
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.EXPORT DATA FILE = <ROOT>/work/tdx_db_big.meta.q3.raw;
/* TDX query=stats db=TDX_DB table=BIG */ SELECT COALESCE(OREPLACE(OREPLACE(TRIM(CAST(MAX(RowCount) AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') FROM DBC.StatsV WHERE DatabaseName = 'TDX_DB' AND TableName = 'BIG';
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.LOGOFF;
.QUIT 0;
