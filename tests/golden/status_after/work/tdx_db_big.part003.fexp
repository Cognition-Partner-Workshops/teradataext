.LOGTABLE tdx_lt_<H>;
.LOGON tdfake.example.com/tdx_test_user,********
.BEGIN EXPORT SESSIONS 4 TENACITY 0;
.EXPORT OUTFILE <ROOT>/data/tdx_db_big.part003.dat.raw FORMAT TEXT MODE RECORD;
/* TDX query=export db=TDX_DB table=BIG chunk=3/4 */ SELECT CAST(CAST(CASE WHEN "ID" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("ID" AS FORMAT '-(10)9') AS VARCHAR(25))) END AS VARCHAR(20) CHARACTER SET LATIN) || TRANSLATE('|' USING UNICODE_TO_LATIN) || CAST(CASE WHEN "VAL" IS NULL THEN '\N' WHEN CHARACTER_LENGTH("VAL") = 0 THEN '\E' ELSE TRANSLATE(OREPLACE(OREPLACE(OREPLACE(OREPLACE("VAL", '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) USING UNICODE_TO_LATIN) END AS VARCHAR(40) CHARACTER SET LATIN) AS VARCHAR(64000) CHARACTER SET LATIN) AS tdx_rec FROM "TDX_DB"."BIG" WHERE ("ID" >= 14 AND "ID" < 20);
.END EXPORT;
.LOGOFF;
