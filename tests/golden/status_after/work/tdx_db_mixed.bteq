.SET SESSION CHARSET 'ASCII';
.LOGON tdfake.example.com/tdx_test_user,********
.SET ERROROUT STDOUT;
.SET ERRORLEVEL UNKNOWN SEVERITY 8;
.EXPORT DATA FILE = <ROOT>/data/tdx_db_mixed.dat.raw;
/* TDX query=export db=TDX_DB table=MIXED */ SELECT CAST((CASE WHEN "ID" IS NULL THEN '\N' ELSE TRIM(CAST("ID" AS VARCHAR(25))) END) || '|' || (CASE WHEN "AMT" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("AMT" AS FORMAT '-(8)9.9(2)') AS VARCHAR(13))) END) || '|' || (CASE WHEN "BIG_AMT" IS NULL THEN '\N' ELSE '"' || TRIM(CAST(CAST("BIG_AMT" AS FORMAT '-(34)9.9(4)') AS VARCHAR(41))) || '"' END) || '|' || (CASE WHEN "NAME" IS NULL THEN '\N' WHEN CHARACTER_LENGTH("NAME") = 0 THEN '\E' ELSE OREPLACE(OREPLACE(OREPLACE(OREPLACE("NAME", '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) END) || '|' || (CASE WHEN "BIZ_DATE" IS NULL THEN '\N' ELSE CAST(CAST("BIZ_DATE" AS FORMAT 'YYYY-MM-DD') AS CHAR(10)) END) || '|' || (CASE WHEN "CREATED_TS" IS NULL THEN '\N' ELSE OREPLACE(TRIM(CAST(CAST("CREATED_TS" AS FORMAT 'YYYY-MM-DDBHH:MI:SS.S(6)') AS VARCHAR(27))), ' ', 'T') END) || '|' || (CASE WHEN "EVENT_TSZ" IS NULL THEN '\N' ELSE OREPLACE(TRIM(CAST(CAST(CAST(("EVENT_TSZ" AT TIME ZONE INTERVAL '00:00' HOUR TO MINUTE) AS TIMESTAMP(6)) AS FORMAT 'YYYY-MM-DDBHH:MI:SS.S(6)') AS VARCHAR(27))), ' ', 'T') || 'Z' END) || '|' || (CASE WHEN "PAYLOAD" IS NULL THEN '\N' WHEN BYTES("PAYLOAD") = 0 THEN '\E' ELSE FROM_BYTES("PAYLOAD", 'base16') END) AS VARCHAR(64000)) AS tdx_rec FROM "TDX_DB"."MIXED";
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.LOGOFF;
.QUIT 0;
