.SET SESSION CHARSET 'UTF8';
.LOGON tdfake.example.com/tdx_test_user,********
.SET ERROROUT STDOUT;
.SET ERRORLEVEL UNKNOWN SEVERITY 8;
.EXPORT DATA FILE = <ROOT>/data/tdx_db_types.dat.raw;
/* TDX query=export db=TDX_DB table=TYPES */ SELECT CAST((CASE WHEN "ID" IS NULL THEN '\N' ELSE TRIM(CAST("ID" AS VARCHAR(25))) END) || '|' || (CASE WHEN "B1" IS NULL THEN '\N' ELSE TRIM(CAST("B1" AS VARCHAR(25))) END) || '|' || (CASE WHEN "S2" IS NULL THEN '\N' ELSE TRIM(CAST("S2" AS VARCHAR(25))) END) || '|' || (CASE WHEN "BIGI" IS NULL THEN '\N' ELSE TRIM(CAST("BIGI" AS VARCHAR(25))) END) || '|' || (CASE WHEN "DEC0" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("DEC0" AS FORMAT '-(18)9') AS VARCHAR(21))) END) || '|' || (CASE WHEN "NUM_UNB" IS NULL THEN '\N' ELSE TRIM(CAST("NUM_UNB" AS VARCHAR(60))) END) || '|' || (CASE WHEN "NUM_10" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("NUM_10" AS FORMAT '-(7)9.9(3)') AS VARCHAR(13))) END) || '|' || (CASE WHEN "FLT" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("FLT" AS FORMAT '-9.9(16)E-999') AS VARCHAR(30))) END) || '|' || (CASE WHEN "DT" IS NULL THEN '\N' ELSE CAST(CAST("DT" AS FORMAT 'YYYY-MM-DD') AS CHAR(10)) END) || '|' || (CASE WHEN "TM" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("TM" AS FORMAT 'HH:MI:SS') AS VARCHAR(16))) END) || '|' || (CASE WHEN "TMZ" IS NULL THEN '\N' ELSE TRIM(CAST(CAST(CAST(("TMZ" AT TIME ZONE INTERVAL '00:00' HOUR TO MINUTE) AS TIME(3)) AS FORMAT 'HH:MI:SS.S(3)') AS VARCHAR(16))) || 'Z' END) || '|' || (CASE WHEN "TS0" IS NULL THEN '\N' ELSE OREPLACE(TRIM(CAST(CAST("TS0" AS FORMAT 'YYYY-MM-DDBHH:MI:SS') AS VARCHAR(27))), ' ', 'T') END) || '|' || (CASE WHEN "IV" IS NULL THEN '\N' ELSE TRIM(CAST("IV" AS VARCHAR(40))) END) || '|' || (CASE WHEN "PER" IS NULL THEN '\N' ELSE TRIM(CAST("PER" AS VARCHAR(80))) END) || '|' || (CASE WHEN "CH_L" IS NULL THEN '\N' ELSE OREPLACE(OREPLACE(OREPLACE(OREPLACE("CH_L", '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) END) || '|' || (CASE WHEN "CH_U" IS NULL THEN '\N' ELSE OREPLACE(OREPLACE(OREPLACE(OREPLACE("CH_U", '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) END) || '|' || (CASE WHEN "VC_U" IS NULL THEN '\N' ELSE OREPLACE(OREPLACE(OREPLACE(OREPLACE("VC_U", '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) END) || '|' || (CASE WHEN "BYT" IS NULL THEN '\N' ELSE FROM_BYTES("BYT", 'base16') END) || '|' || (CASE WHEN "VB" IS NULL THEN '\N' ELSE FROM_BYTES("VB", 'base16') END) || '|' || (CASE WHEN "Spaced Name " IS NULL THEN '\N' ELSE OREPLACE(OREPLACE(OREPLACE(OREPLACE("Spaced Name ", '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) END) AS VARCHAR(32000)) AS tdx_rec FROM "TDX_DB"."TYPES";
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.LOGOFF;
.QUIT 0;
