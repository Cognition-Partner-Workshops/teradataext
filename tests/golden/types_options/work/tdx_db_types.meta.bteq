.SET SESSION CHARSET 'UTF8';
.LOGON tdfake.example.com/tdx_test_user,********
.SET ERROROUT STDOUT;
.SET ERRORLEVEL UNKNOWN SEVERITY 8;
.EXPORT DATA FILE = <ROOT>/work/tdx_db_types.meta.q1.raw;
/* TDX query=columns db=TDX_DB table=TYPES */ SELECT COALESCE(CAST(OREPLACE(OREPLACE(TRIM(CAST(CAST(CAST(ColumnId AS BIGINT) AS FORMAT '-(19)9') AS VARCHAR(256))), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') || '|' || COALESCE(CAST(OREPLACE(OREPLACE(CAST(ColumnName AS VARCHAR(256)), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') || '|' || COALESCE(CAST(OREPLACE(OREPLACE(TRIM(CAST(ColumnType AS VARCHAR(256))), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') || '|' || COALESCE(CAST(OREPLACE(OREPLACE(TRIM(CAST(CAST(CAST(ColumnLength AS BIGINT) AS FORMAT '-(19)9') AS VARCHAR(256))), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') || '|' || COALESCE(CAST(OREPLACE(OREPLACE(TRIM(CAST(CAST(CAST(DecimalTotalDigits AS BIGINT) AS FORMAT '-(19)9') AS VARCHAR(256))), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') || '|' || COALESCE(CAST(OREPLACE(OREPLACE(TRIM(CAST(CAST(CAST(DecimalFractionalDigits AS BIGINT) AS FORMAT '-(19)9') AS VARCHAR(256))), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') || '|' || COALESCE(CAST(OREPLACE(OREPLACE(TRIM(CAST(Nullable AS VARCHAR(256))), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') || '|' || COALESCE(CAST(OREPLACE(OREPLACE(TRIM(CAST(CAST(CAST(CharType AS BIGINT) AS FORMAT '-(19)9') AS VARCHAR(256))), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') FROM DBC.ColumnsV WHERE DatabaseName = 'TDX_DB' AND TableName = 'TYPES' ORDER BY ColumnId;
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.EXPORT DATA FILE = <ROOT>/work/tdx_db_types.meta.q2.raw;
/* TDX query=index db=TDX_DB table=TYPES */ SELECT COALESCE(CAST(OREPLACE(OREPLACE(TRIM(CAST(IndexType AS VARCHAR(256))), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') || '|' || COALESCE(CAST(OREPLACE(OREPLACE(TRIM(CAST(UniqueFlag AS VARCHAR(256))), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') || '|' || COALESCE(CAST(OREPLACE(OREPLACE(TRIM(CAST(CAST(CAST(ColumnPosition AS BIGINT) AS FORMAT '-(19)9') AS VARCHAR(256))), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') || '|' || COALESCE(CAST(OREPLACE(OREPLACE(CAST(ColumnName AS VARCHAR(256)), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') FROM DBC.IndicesV WHERE DatabaseName = 'TDX_DB' AND TableName = 'TYPES' ORDER BY IndexNumber, ColumnPosition;
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.EXPORT DATA FILE = <ROOT>/work/tdx_db_types.meta.q3.raw;
/* TDX query=stats db=TDX_DB table=TYPES */ SELECT COALESCE(CAST(OREPLACE(OREPLACE(TRIM(CAST(CAST(CAST(MAX(RowCount) AS BIGINT) AS FORMAT '-(19)9') AS VARCHAR(256))), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') FROM DBC.StatsV WHERE DatabaseName = 'TDX_DB' AND TableName = 'TYPES';
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.LOGOFF;
.QUIT 0;
