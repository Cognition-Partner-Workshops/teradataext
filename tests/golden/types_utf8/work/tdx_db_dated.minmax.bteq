.SET SESSION CHARSET 'UTF8';
.LOGON tdfake.example.com/tdx_test_user,********
.SET ERROROUT STDOUT;
.SET ERRORLEVEL UNKNOWN SEVERITY 8;
.EXPORT DATA FILE = <ROOT>/work/tdx_db_dated.minmax.q1.raw;
/* TDX query=minmax db=TDX_DB table=DATED col=BIZ_DATE */ SELECT COALESCE(CAST(OREPLACE(OREPLACE(TRIM(CAST(CAST(CAST(MIN("BIZ_DATE") AS FORMAT 'YYYY-MM-DD') AS CHAR(10)) AS VARCHAR(256))), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') || '|' || COALESCE(CAST(OREPLACE(OREPLACE(TRIM(CAST(CAST(CAST(MAX("BIZ_DATE") AS FORMAT 'YYYY-MM-DD') AS CHAR(10)) AS VARCHAR(256))), '\', '\\'), '|', '\|') AS VARCHAR(512)), '\N') FROM "TDX_DB"."DATED";
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.LOGOFF;
.QUIT 0;
