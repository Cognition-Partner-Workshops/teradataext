.LOGTABLE tdx_lt_<H>;
.LOGON tdfake.example.com/tdx_test_user,********
.BEGIN EXPORT SESSIONS 4 TENACITY 0;
.EXPORT OUTFILE <ROOT>/data/tdx_db_dated.part001.dat.raw FORMAT TEXT MODE RECORD;
/* TDX query=export db=TDX_DB table=DATED chunk=1/3 */ SELECT CAST(CAST(CASE WHEN "BIZ_DATE" IS NULL THEN '\N' ELSE CAST(CAST("BIZ_DATE" AS FORMAT 'YYYY-MM-DD') AS CHAR(10)) END AS VARCHAR(10)) || '|' || CAST(CASE WHEN "VAL" IS NULL THEN '\N' WHEN CHARACTER_LENGTH("VAL") = 0 THEN '\E' ELSE TRANSLATE(OREPLACE(OREPLACE(OREPLACE(OREPLACE("VAL", '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) USING UNICODE_TO_LATIN) END AS VARCHAR(40)) AS VARCHAR(64000)) AS tdx_rec FROM "TDX_DB"."DATED" WHERE ("BIZ_DATE" < DATE '2024-01-08' OR "BIZ_DATE" IS NULL);
.END EXPORT;
.LOGOFF;
