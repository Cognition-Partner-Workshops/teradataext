.LOGTABLE tdx_lt_<H>;
.LOGON tdfake.example.com/tdx_test_user,********
.BEGIN EXPORT SESSIONS 4 TENACITY 0;
.EXPORT OUTFILE <ROOT>/data/tdx_db_hashed.part003.dat.raw FORMAT TEXT MODE RECORD;
/* TDX query=export db=TDX_DB table=HASHED chunk=3/4 */ SELECT CAST((CASE WHEN "CODE" IS NULL THEN '\N' WHEN CHARACTER_LENGTH("CODE") = 0 THEN '\E' ELSE OREPLACE(OREPLACE(OREPLACE(OREPLACE("CODE", '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) END) || '|' || (CASE WHEN "VAL" IS NULL THEN '\N' WHEN CHARACTER_LENGTH("VAL") = 0 THEN '\E' ELSE OREPLACE(OREPLACE(OREPLACE(OREPLACE("VAL", '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) END) AS VARCHAR(64000)) AS tdx_rec FROM "TDX_DB"."HASHED" WHERE (HASHBUCKET(HASHROW("CODE")) MOD 4 = 2);
.END EXPORT;
.LOGOFF;
