.LOGTABLE tdx_lt_<H>;
.LOGON tdfake.example.com/tdx_test_user,********
.BEGIN EXPORT SESSIONS 4 TENACITY 0;
.EXPORT OUTFILE <ROOT>/data/tdx_db_hashed.part004.dat.raw FORMAT TEXT MODE RECORD;
/* TDX query=export db=TDX_DB table=HASHED chunk=4/4 */ SELECT CAST(CAST(TRANSLATE(CASE WHEN "CODE" IS NULL THEN '\N' WHEN CHARACTER_LENGTH(OREPLACE("CODE", '00'XC, '')) = 0 THEN '\E' ELSE TRANSLATE(OREPLACE(OREPLACE(OREPLACE(OREPLACE(OREPLACE("CODE", '00'XC, ''), '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) USING UNICODE_TO_LATIN) END USING UNICODE_TO_LATIN) AS VARCHAR(20)) || TRANSLATE('|' USING UNICODE_TO_LATIN) || CAST(TRANSLATE(CASE WHEN "VAL" IS NULL THEN '\N' WHEN CHARACTER_LENGTH(OREPLACE("VAL", '00'XC, '')) = 0 THEN '\E' ELSE TRANSLATE(OREPLACE(OREPLACE(OREPLACE(OREPLACE(OREPLACE("VAL", '00'XC, ''), '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) USING UNICODE_TO_LATIN) END USING UNICODE_TO_LATIN) AS VARCHAR(40)) AS VARCHAR(64000)) AS tdx_rec FROM "TDX_DB"."HASHED" WHERE (HASHBUCKET(HASHROW("CODE")) MOD 4 = 3);
.END EXPORT;
.LOGOFF;
