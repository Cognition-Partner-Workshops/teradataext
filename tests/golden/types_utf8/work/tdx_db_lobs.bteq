.SET SESSION CHARSET 'UTF8';
.LOGON tdfake.example.com/tdx_test_user,********
.SET ERROROUT STDOUT;
.SET ERRORLEVEL UNKNOWN SEVERITY 8;
.EXPORT DATA FILE = <ROOT>/data/tdx_db_lobs.dat.raw;
/* TDX query=export db=TDX_DB table=LOBS */ SELECT CAST((CASE WHEN "ID" IS NULL THEN '\N' ELSE TRIM(CAST("ID" AS VARCHAR(25))) END) || '|' || (CASE WHEN "CL" IS NULL THEN '\N' WHEN CHARACTER_LENGTH(CAST("CL" AS VARCHAR(1000))) = 0 THEN '\E' ELSE OREPLACE(OREPLACE(OREPLACE(OREPLACE(CAST("CL" AS VARCHAR(1000)), '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) END) || '|' || (CASE WHEN "JS" IS NULL THEN '\N' WHEN CHARACTER_LENGTH(CAST("JS" AS VARCHAR(1000))) = 0 THEN '\E' ELSE OREPLACE(OREPLACE(OREPLACE(OREPLACE(CAST("JS" AS VARCHAR(1000)), '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) END) || '|' || (CASE WHEN "XMLC" IS NULL THEN '\N' WHEN CHARACTER_LENGTH(XMLSERIALIZE(CONTENT "XMLC" AS VARCHAR(1000))) = 0 THEN '\E' ELSE OREPLACE(OREPLACE(OREPLACE(OREPLACE(XMLSERIALIZE(CONTENT "XMLC" AS VARCHAR(1000)), '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) END) || '|' || (CASE WHEN "BL" IS NULL THEN '\N' WHEN BYTES(CAST("BL" AS VARBYTE(1000))) = 0 THEN '\E' ELSE FROM_BYTES(CAST("BL" AS VARBYTE(1000)), 'base16') END) AS VARCHAR(32000)) AS tdx_rec FROM "TDX_DB"."LOBS";
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.LOGOFF;
.QUIT 0;
