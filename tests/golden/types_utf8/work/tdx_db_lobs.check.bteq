.SET SESSION CHARSET 'UTF8';
.LOGON tdfake.example.com/tdx_test_user,********
.SET ERROROUT STDOUT;
.SET ERRORLEVEL UNKNOWN SEVERITY 8;
.EXPORT DATA FILE = <ROOT>/work/tdx_db_lobs.check.q1.raw;
/* TDX query=lobcheck db=TDX_DB table=LOBS cols="CL,JS,XMLC,BL" */ SELECT COALESCE(OREPLACE(OREPLACE(TRIM(CAST(MAX(CHARACTER_LENGTH("CL")) AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') || '|' || COALESCE(OREPLACE(OREPLACE(TRIM(CAST(MAX(CHARACTER_LENGTH(CAST("JS" AS CLOB))) AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') || '|' || COALESCE(OREPLACE(OREPLACE(TRIM(CAST(MAX(CHARACTER_LENGTH(XMLSERIALIZE(CONTENT "XMLC" AS CLOB))) AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') || '|' || COALESCE(OREPLACE(OREPLACE(TRIM(CAST(MAX(BYTES("BL")) AS VARCHAR(256)))), '\', '\\'), '|', '\|'), '\N') FROM "TDX_DB"."LOBS";
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.LOGOFF;
.QUIT 0;
