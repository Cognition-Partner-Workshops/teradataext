.SET SESSION CHARSET 'UTF8';
.LOGON tdfake.example.com/tdx_test_user,********
.SET ERROROUT STDOUT;
.SET ERRORLEVEL UNKNOWN SEVERITY 8;
.EXPORT DATA FILE = <ROOT>/data/tdx_db_types.dat.raw;
/* TDX query=export db=TDX_DB table=TYPES */ SELECT CAST(CAST(CASE WHEN "ID" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("ID" AS FORMAT '-(10)9') AS VARCHAR(25))) END AS VARCHAR(20)) || '|' || CAST(CASE WHEN "B1" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("B1" AS FORMAT '-(3)9') AS VARCHAR(25))) END AS VARCHAR(20)) || '|' || CAST(CASE WHEN "S2" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("S2" AS FORMAT '-(5)9') AS VARCHAR(25))) END AS VARCHAR(20)) || '|' || CAST(CASE WHEN "BIGI" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("BIGI" AS FORMAT '-(19)9') AS VARCHAR(25))) END AS VARCHAR(20)) || '|' || CAST(CASE WHEN "DEC0" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("DEC0" AS FORMAT '-(18)9') AS VARCHAR(21))) END AS VARCHAR(21)) || '|' || CAST(CASE WHEN "NUM_UNB" IS NULL THEN '\N' ELSE '"' || TRIM(CAST("NUM_UNB" AS VARCHAR(60))) || '"' END AS VARCHAR(62)) || '|' || CAST(CASE WHEN "NUM_10" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("NUM_10" AS FORMAT '-(7)9.9(3)') AS VARCHAR(13))) END AS VARCHAR(13)) || '|' || CAST(CASE WHEN "FLT" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("FLT" AS FORMAT '-9.9(16)E-999') AS VARCHAR(30))) END AS VARCHAR(25)) || '|' || CAST(CASE WHEN "DT" IS NULL THEN '\N' ELSE CAST(CAST("DT" AS FORMAT 'YYYY-MM-DD') AS CHAR(10)) END AS VARCHAR(10)) || '|' || CAST(CASE WHEN "TM" IS NULL THEN '\N' ELSE TRIM(CAST(CAST("TM" AS FORMAT 'HH:MI:SS') AS VARCHAR(16))) END AS VARCHAR(17)) || '|' || CAST(CASE WHEN "TMZ" IS NULL THEN '\N' ELSE TRIM(CAST(CAST(CAST(("TMZ" AT TIME ZONE INTERVAL '00:00' HOUR TO MINUTE) AS TIME(3)) AS FORMAT 'HH:MI:SS.S(3)') AS VARCHAR(16))) || 'Z' END AS VARCHAR(17)) || '|' || CAST(CASE WHEN "TS0" IS NULL THEN '\N' ELSE SUBSTR(TRIM(CAST(CAST("TS0" AS FORMAT 'YYYY-MM-DDBHH:MI:SS') AS VARCHAR(27))), 1, 10) || 'T' || SUBSTR(TRIM(CAST(CAST("TS0" AS FORMAT 'YYYY-MM-DDBHH:MI:SS') AS VARCHAR(27))), 12) END AS VARCHAR(28)) || '|' || CAST(CASE WHEN "IV" IS NULL THEN '\N' ELSE TRIM(CAST("IV" AS VARCHAR(40))) END AS VARCHAR(40)) || '|' || CAST(CASE WHEN "PER" IS NULL THEN '\N' ELSE TRIM(CAST("PER" AS VARCHAR(80))) END AS VARCHAR(80)) || '|' || CAST(CASE WHEN "CH_L" IS NULL THEN '\N' WHEN CHARACTER_LENGTH(OREPLACE(TRIM(TRAILING FROM "CH_L"), '00'XC, '')) = 0 THEN '\E' ELSE TRANSLATE(OREPLACE(OREPLACE(OREPLACE(OREPLACE(OREPLACE(TRIM(TRAILING FROM "CH_L"), '00'XC, ''), '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) USING UNICODE_TO_LATIN) END AS VARCHAR(20)) || '|' || CAST(CASE WHEN "CH_U" IS NULL THEN '\N' WHEN CHARACTER_LENGTH(OREPLACE(TRIM(TRAILING FROM "CH_U"), '00'XC, '')) = 0 THEN '\E' ELSE OREPLACE(OREPLACE(OREPLACE(OREPLACE(OREPLACE(TRIM(TRAILING FROM "CH_U"), '00'XC, ''), '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) END AS VARCHAR(20)) || '|' || CAST(CASE WHEN "VC_U" IS NULL THEN '\N' WHEN CHARACTER_LENGTH(OREPLACE("VC_U", '00'XC, '')) = 0 THEN '\E' ELSE OREPLACE(OREPLACE(OREPLACE(OREPLACE(OREPLACE("VC_U", '00'XC, ''), '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) END AS VARCHAR(100)) || '|' || CAST(CASE WHEN "BYT" IS NULL THEN '\N' WHEN BYTES("BYT") = 0 THEN '\E' ELSE TRIM(TRAILING '-' FROM REGEXP_REPLACE(FROM_BYTES("BYT", 'base16'), '([0-9A-F]{2})', '\1-', 1, 0, 'c')) END AS VARCHAR(11)) || '|' || CAST(CASE WHEN "VB" IS NULL THEN '\N' WHEN BYTES("VB") = 0 THEN '\E' ELSE TRIM(TRAILING '-' FROM REGEXP_REPLACE(FROM_BYTES("VB", 'base16'), '([0-9A-F]{2})', '\1-', 1, 0, 'c')) END AS VARCHAR(23)) || '|' || CAST(CASE WHEN "Spaced Name " IS NULL THEN '\N' WHEN CHARACTER_LENGTH(OREPLACE("Spaced Name ", '00'XC, '')) = 0 THEN '\E' ELSE TRANSLATE(OREPLACE(OREPLACE(OREPLACE(OREPLACE(OREPLACE("Spaced Name ", '00'XC, ''), '\', '\\'), '|', '\|'), '0D'XC, '\' || '0D'XC), '0A'XC, '\' || '0A'XC) USING UNICODE_TO_LATIN) END AS VARCHAR(20)) AS VARCHAR(32000)) AS tdx_rec FROM "TDX_DB"."TYPES";
.IF ERRORCODE <> 0 THEN .QUIT 8;
.EXPORT RESET;
.LOGOFF;
.QUIT 0;
